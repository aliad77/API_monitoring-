# PostgreSQL connection used by the web app, the worker and Prisma.
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse"

# Separate database for integration tests (created by docker/init-test-db.sql).
# Leave unset to skip the database-backed test suite.
TEST_DATABASE_URL="postgresql://pulse:pulse@localhost:5432/pulse_test"

# Auth.js session secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Required when not running on a platform that sets the host for Auth.js.
AUTH_TRUST_HOST=true

# Optional: password for the demo account created by `npm run db:seed`.
SEED_DEMO_PASSWORD="pulse-demo-password"
